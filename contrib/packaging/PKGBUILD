# Maintainer: Pando85 <pando855@gmail.com>
pkgname=passless-rs
pkgver=0.2.0
pkgrel=1
pkgdesc="FIDO2 security token emulator"
arch=('x86_64' 'aarch64')
url="https://github.com/pando85/passless"
license=('custom')
depends=('tpm2-tss')
makedepends=('cargo' 'git')
optdepends=(
    'password-store: for password-store backend support'
    'gnupg: for GPG encryption in password-store backend'
)
source=("git+https://github.com/pando85/passless.git#tag=v${pkgver}")
sha256sums=('SKIP')
options=(!lto)

prepare() {
    cd "${srcdir}/passless"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "${srcdir}/passless"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --all-features
}

check() {
    cd "${srcdir}/passless"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --frozen --all-features
}

package() {
    cd "${srcdir}/passless"

    # Install binary
    install -Dm755 "target/release/passless" "${pkgdir}/usr/bin/passless"

    # Install shell completions
    # The completions are generated during build in OUT_DIR/completions
    local _completion_dir="$(find target/release/build/passless-rs-*/out/completions -type d 2>/dev/null | head -1)"
    if [ -n "$_completion_dir" ]; then
        install -Dm644 "${_completion_dir}/passless.bash" "${pkgdir}/usr/share/bash-completion/completions/passless"
        install -Dm644 "${_completion_dir}/passless.fish" "${pkgdir}/usr/share/fish/vendor_completions.d/passless.fish"
        install -Dm644 "${_completion_dir}/_passless" "${pkgdir}/usr/share/zsh/site-functions/_passless"
        install -Dm644 "${_completion_dir}/passless.elv" "${pkgdir}/usr/share/elvish/lib/passless.elv"
    fi

    # Install systemd user service
    install -Dm644 "contrib/systemd/passless.service" "${pkgdir}/usr/lib/systemd/user/passless.service"

    # Install udev rules
    install -Dm644 "contrib/udev/90-passless.rules" "${pkgdir}/usr/lib/udev/rules.d/90-passless.rules"

    # Install sysusers configuration
    install -Dm644 "contrib/sysusers.d/passless.conf" "${pkgdir}/usr/lib/sysusers.d/passless.conf"

    # Install license
    install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

    # Install documentation
    install -Dm644 "README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
    install -Dm644 "config.toml.example" "${pkgdir}/usr/share/doc/${pkgname}/config.toml.example"
}
