# Passless Agent Daemon
#
# The daemon MUST run as root to enforce principal isolation (separate UIDs,
# namespaces) and to launch managed browsers under separate Unix identities via
# setuid. Do not change User/Group.
#
# Agents use only the browser-extension path. They get no UHID or hidraw device
# of their own, so this unit installs no agent udev rule and grants no device
# access to principals or browser users. The human authenticator's UHID device
# is managed by passless.service and contrib/udev/90-passless.rules.
#
# Review hardening directives for your distribution before enabling.
# Some directives may conflict with dynamic setuid/browser launch.

[Unit]
Description=Passless FIDO2 Agent Daemon
Documentation=https://github.com/pando85/passless
After=network-online.target systemd-logind.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/passless --verbose
Restart=on-failure
RestartSec=5s

# The daemon requires root for principal isolation and setuid browser launch.
# Do not add User= or Group= directives.

# Filesystem
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/passless-agent /var/run/passless-agent /var/run/passless-browser
# The default agents.state_dir (granted rules, audit) is systemd-managed. It is root:root 0700,
# the same as contrib/tmpfiles/passless-agent.conf; StateDirectoryMode keeps systemd from
# widening it to its 0755 default.
StateDirectory=passless-agent
StateDirectoryMode=0700
PrivateTmp=true
# Note: /var/run/passless-browser/<profile> directories are created per-profile
# and owned by the configured browser_user. The daemon creates and cleans these
# directories, so the parent must remain writable under ProtectSystem=strict.

# Process
NoNewPrivileges=false
# Note: NoNewPrivileges=false is required because the daemon uses setuid to
# launch principal and browser processes under separate Unix identities.

# Namespaces / devices
PrivateDevices=false
# Agents have no UHID/hidraw device of their own; no DeviceAllow= entries are
# needed for them. The directive value is unchanged from earlier releases and is
# kept because the root daemon launches managed browsers under other identities
# and has not been profiled against a private /dev. Never grant host devices
# (including /dev/uhid) to principals or browser users.
#
# RestrictAddressFamilies is intentionally deferred. The restriction is inherited
# by managed Chromium, which requires AF_INET/AF_INET6 for RP access and may use
# AF_NETLINK for host network state. Add it only after the browser syscall/socket
# surface is validated for the supported Chromium configurations.

# Logging
Environment=PASSLESS_SYSLOG_IDENTIFIER=passless-agent
StandardOutput=journal
StandardError=journal
SyslogIdentifier=passless-agent

# Limits
LimitMEMLOCK=64M
LimitNOFILE=1024

# Security: additive controls that do not interfere with cross-user setuid launch.
ProtectHostname=true
ProtectClock=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true

# Higher-risk hardening remains deliberately deferred until it is profiled against
# the root multi-principal browser path: CapabilityBoundingSet, SystemCallFilter,
# RestrictNamespaces, ProtectProc/ProcSubset, and MemoryDenyWriteExecute.

[Install]
WantedBy=multi-user.target
