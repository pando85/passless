{
  "manifest_version": 3,
  "name": "passless-agent",
  "version": "2.0.0",
  "description": "Routes WebAuthn requests of a Passless managed browser to the Passless daemon.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "webAuthenticationProxy",
    "nativeMessaging",
    "storage"
  ],
  "incognito": "spanning",
  "background": {
    "service_worker": "worker.js"
  }
}
