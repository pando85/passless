# Passless Configuration File Example
# Place this file at: ~/.config/passless/config.toml

# Backend type: "local", "pass", or "tpm"
backend_type = "local"

# Enable verbose logging
verbose = false

# === Local Backend Configuration ===
# Path to local storage directory
# Default: $XDG_DATA_HOME/passless or $HOME/.local/share/passless
# local_path = "/custom/path/to/storage"

# === Pass (password-store) Backend Configuration ===
[pass]
# Path to password store directory
# Default: $HOME/.password-store
# store_path = "/custom/password-store"

# Relative path within password store for FIDO2 entries
# Default: "fido2"
path = "fido2"

# GPG backend: "gpgme" or "gnupg-bin"
# Default: "gnupg-bin"
gpg_backend = "gnupg-bin"

# === TPM Backend Configuration ===
[tpm]
# Path to TPM storage directory
# Default: $XDG_DATA_HOME/passless/tpm or $HOME/.local/share/passless/tpm
# path = "/custom/tpm/storage"

# TPM TCTI configuration
# Examples:
#   - Hardware TPM: "device:/dev/tpmrm0"
#   - swtpm socket: "swtpm:path=/path/to/socket"
# Default: "device:/dev/tpmrm0"
tcti = "device:/dev/tpmrm0"

# === Security Configuration ===
[security]
# Use mlock to prevent credentials from being swapped to disk
# Requires CAP_IPC_LOCK capability
# Default: true
use_mlock = true

# Disable core dumps to prevent credential leakage
# Default: true
disable_core_dumps = true

# Enable constant signature counter
# Helps relying parties detect cloned authenticators
# Default: false
constant_signature_counter = false

# Show user verification notification during registration
# Default: true
user_verification_registration = true

# Show user verification notification during authentication
# Default: true
user_verification_authentication = true
